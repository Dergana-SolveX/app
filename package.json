{
  "name": "solvex-dergana",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.12",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@trpc/tanstack-react-query": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "@tanstack/react-query": "^5.104.2",
      "@tanstack/react-form": "^1.33.5",
      "tailwindcss": "^4.3.3",
      "@better-auth/expo": "1.7.12",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "dev:gateway": "turbo run dev -F gateway --",
    "db:push": "turbo run db:push -F @solvex-dergana/db --",
    "db:studio": "turbo run db:studio -F @solvex-dergana/db --",
    "db:generate": "turbo run db:generate -F @solvex-dergana/db --",
    "db:migrate": "turbo run db:migrate -F @solvex-dergana/db --",
    "db:seed": "turbo run db:seed -F @solvex-dergana/db --",
    "db:reset": "turbo run db:reset -F @solvex-dergana/db --",
    "db:import-cells": "cd packages/db && bun src/import-cells.ts",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./apps/gateway/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/ && varlock codegen --path ./apps/gateway/",
    "auth:generate": "cd apps/server && bun run auth:generate"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@solvex-dergana/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
