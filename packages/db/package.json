{
  "name": "@solvex-dergana/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./seed/*": "./src/seed/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun src/seed/run.ts",
    "db:reset": "bun src/seed/run.ts --reset",
    "db:import-cells": "bun src/import-cells.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.23.0",
    "zod": "catalog:",
    "@solvex-dergana/shared": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@solvex-dergana/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "^6.0.3",
    "varlock": "catalog:",
    "vitest": "^4.0.0"
  }
}
