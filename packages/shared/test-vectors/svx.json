    }
  ],
  "verify": [
    {
      "name": "genuine signed message",
      "sms": "SVX1#L:1#GH:sn2j5x7k#T:hsmn0#G:8.5#R:1#FIRE:1#V:3#C:0#TR:1#B:0#UID:K7Q2M9XA#DV:42#CI:25B-1-1A2B-3C4D5E#H:AJ6N67#CK:05",
      "valid": true
