# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Where the SVX server listens: every SMS the modem receives is handed to it
# @public @type=url
SERVER_URL=http://localhost:3000

# Must equal the server's GATEWAY_SHARED_SECRET. Optional here so that `bun run dev` works on a machine
# without a modem; src/index.ts requires it as soon as MODEM_PORT is set.
# @optional @type=string(minLength=24)
GATEWAY_SHARED_SECRET=

# Serial port of the USB modem's AT-command port (COM3 on Windows, /dev/ttyUSB2 on Linux).
# Empty: the gateway stays idle, so `bun run dev` works on a machine without a modem.
# @public @optional
MODEM_PORT=

# @public @type=number
MODEM_BAUD=115200

# The port apps/gateway listens on (the server's GATEWAY_URL points here)
# @public @type=number
GATEWAY_PORT=3002
