BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Neon: direct connection (migrations) and pooled connection (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# AI (Mistral)
AI_ENABLED=true
MISTRAL_API_KEY=
MISTRAL_STT_MODEL=voxtral-mini-latest
MISTRAL_VISION_MODEL=pixtral-large-latest

# Shared secret between apps/gateway and POST /internal/sms (openssl rand -hex 24)
GATEWAY_SHARED_SECRET=

# Root secret for per-device HMAC keys (openssl rand -hex 32)
MASTER_DEVICE_SECRET=
SMS_TRANSPORT=emulator

# Shared password of all seeded demo logins (min 8 chars)
DEMO_PASSWORD=svx-demo-2026
