# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Neon direct connection (migrations, drizzle-kit)
# @type=string(minLength=1)
DATABASE_URL=

# Neon pooled connection (runtime queries)
# @type=string(minLength=1)
DATABASE_URL_POOLED=

# @public @type=enum(true, false)
AI_ENABLED=true

# @type=string(minLength=1)
MISTRAL_API_KEY=

# @public @type=string(minLength=1)
MISTRAL_STT_MODEL=voxtral-mini-latest

# @public @type=string(minLength=1)
MISTRAL_VISION_MODEL=pixtral-large-latest

# Shared secret between apps/gateway and POST /internal/sms
# @type=string(minLength=24)
GATEWAY_SHARED_SECRET=

# Root secret for per-device HMAC keys (HKDF per device_id)
# @type=string(minLength=32)
MASTER_DEVICE_SECRET=

# @public @type=enum(emulator, android, modem)
SMS_TRANSPORT=emulator
