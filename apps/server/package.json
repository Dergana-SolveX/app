{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "test": "vitest run",
    "simulate:device": "bun run src/simulate-device.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@solvex-dergana/api": "workspace:*",
    "@solvex-dergana/auth": "workspace:*",
    "@solvex-dergana/db": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:",
    "@solvex-dergana/shared": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@solvex-dergana/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
